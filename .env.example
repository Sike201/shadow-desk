# Solana RPC (Helius recommended)
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Privy (https://dashboard.privy.io) — App ID is public; secret is server-only
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Privacy Cash indexer + relayer API
NEXT_PUBLIC_PRIVACY_CASH_BACKEND_URL=https://api3.privacycash.org

# Optional: ship circuit artifacts in public/circuit/ (see README)
# NEXT_PUBLIC_PRIVACY_CASH_PROGRAM_ID=
